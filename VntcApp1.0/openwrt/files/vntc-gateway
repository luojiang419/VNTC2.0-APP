#!/bin/sh
# 不增加常驻进程；仅生成属于本插件的 fw4/UCI 规则。
# OpenWrt /lib/functions.sh 会读取可选的未定义变量，不使用 nounset。
set -e
. /lib/functions.sh

die() { echo "vntc-gateway: $*" >&2; exit 1; }
marker=/etc/vntc/.gateway-managed
action="${1:-apply}"
case "$action" in apply|remove) ;; *) die '用法：vntc-gateway [apply|remove]' ;; esac
if [ ! -f /etc/config/firewall ] || [ ! -x /sbin/fw4 ]; then
    [ "$(uci -q get vntc_gateway.main.enabled || true)" != 1 ] || die '网关转发需要 OpenWrt firewall4'
    exit 0
fi
[ -z "$(uci changes firewall)" ] || die '请先提交或撤销已有防火墙暂存修改'
mkdir /var/lock/vntc-gateway.lock 2>/dev/null || die '另一个网关操作正在执行'
work="$(mktemp -d /tmp/vntcg.XXXXXX)"
trap 'rm -rf "$work"; rmdir /var/lock/vntc-gateway.lock' EXIT
cp /etc/config/firewall "$work/firewall"
cp /etc/config/firewall "$work/original"
: > "$work/managed"
mkdir "$work/delta"
# -c 只隔离配置文件，仍会写全局 /tmp/.uci；必须同时隔离 savedir。
cu() { uci -c "$work" -t "$work/delta" "$@"; }
# 只删除之前记录且名称仍属于本插件的节；发现被改写则保留并报错。
if [ -f "$marker" ]; then
    while IFS= read -r old; do
        case "$old" in vntcg_*) ;; *) die '受管规则记录损坏' ;; esac
        case "$old" in *[!a-zA-Z0-9_]*) die '无效规则名称' ;; esac
        if cu -q get "firewall.$old" >/dev/null; then
            [ "$(cu -q get "firewall.$old.name")" = "$old" ] || die "受管节已被修改：$old"
            cu delete "firewall.$old"
        fi
    done < "$marker"
fi
enabled=0
if [ "$action" = apply ] && [ -f /etc/config/vntc_gateway ]; then
    config_load vntc_gateway
    config_get_bool enabled main enabled 0
fi

# 输出 IPv4 网络范围，拒绝默认路由、非规范 CIDR 和非单播网段。
range() {
    echo "$1" | awk -F/ '
    NF!=2 || $2 !~ /^[0-9]+$/ || $2<1 || $2>32 {exit 1}
    {n=split($1,a,"."); if(n!=4)exit 1; v=0;
     for(i=1;i<=4;i++){if(a[i]!~/^[0-9]+$/ || a[i]>255)exit 1; v=v*256+a[i]}
     if(a[1]==0 || a[1]==127 || a[1]>=224)exit 1;
     size=2^(32-$2); base=int(v/size)*size; if(base!=v)exit 1;
     printf "%.0f %.0f\n",base,base+size-1}'
}
overlap() { awk -v a="$1" -v b="$2" 'BEGIN{split(a,x," ");split(b,y," ");exit !(x[1]<=y[2] && y[1]<=x[2])}'; }
port() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
new_section() {
    id="$1"
    ! cu -q get "firewall.$id" >/dev/null || die "规则名称被占用：$id"
    cu set "firewall.$id=$2"
    cu set "firewall.$id.name=$id"
    cu set "firewall.$id.family=ipv4"
    echo "$id" >> "$work/managed"
}
set_rule() { cu set "firewall.$id.$1=$2"; }
add_destinations() {
    cu add_list "firewall.$id.dest_ip=$overlay_cidr"
    for network in $remote_cidr; do cu add_list "firewall.$id.dest_ip=$network"; done
}
add_service() {
    service="$1"
    case "$service" in ''|*[!a-zA-Z0-9_]*) die '服务必须使用有名称的 UCI 节（字母数字下划线）' ;; esac
    config_get proto "$service" proto tcp
    config_get listen_port "$service" listen_port
    config_get dest_ip "$service" dest_ip
    config_get dest_port "$service" dest_port
    case "$proto" in tcp|udp) ;; *) die '服务协议仅支持 tcp 或 udp' ;; esac
    port "$listen_port" && port "$dest_port" || die "无效服务端口：$service"
    dest_range="$(range "$dest_ip/32")" || die "无效目标 IP：$service"
    overlap "$dest_range" "$lan_range" || die "目标必须属于本地 LAN：$service"
    ! grep -qx "$proto:$listen_port" "$work/ports" || die '重复监听端口'
    echo "$proto:$listen_port" >> "$work/ports"
    new_section "vntcg_map_$service" redirect
    set_rule src vntc_openwrt
    set_rule src_dip "$virtual_ip"
    set_rule src_dport "$listen_port"
    set_rule dest "$lan_zone"
    set_rule dest_ip "$dest_ip"
    set_rule dest_port "$dest_port"
    set_rule proto "$proto"
    set_rule target DNAT
    set_rule reflection 0
}

if [ "$enabled" = 1 ]; then
    [ -f /etc/vntc/.firewall-managed ] || die '请先安装 vntc 防火墙分区'
    config_get lan_zone main lan_zone lan
    case "$lan_zone" in ''|*[!a-zA-Z0-9_]*) die '无效 LAN 分区名' ;; esac
    [ "$lan_zone" != vntc_openwrt ] && [ "$lan_zone" != wan ] || die '请选择实际 LAN 分区'
    uci show firewall | grep -q "\.name='$lan_zone'$" || die '找不到指定 LAN 分区'
    config_get lan_cidr main lan_cidr
    config_get overlay_cidr main overlay_cidr
    config_get remote_cidr main remote_cidr
    lan_range="$(range "$lan_cidr")" || die '无效本地 LAN 网段'
    overlay_range="$(range "$overlay_cidr")" || die '无效虚拟网段'
    ! overlap "$lan_range" "$overlay_range" || die '本地 LAN 与虚拟网段重叠'
    for network in $remote_cidr; do
        remote_range="$(range "$network")" || die '无效远端网段'
        ! overlap "$remote_range" "$lan_range" || die '远端与本地 LAN 重叠'
        ! overlap "$remote_range" "$overlay_range" || die '远端与虚拟网段重叠'
    done
    virtual_ip="$(jsonfilter -i /etc/vntc/config.json -e '@.vnt.virtual_ip')"
    virtual_range="$(range "$virtual_ip/32")" || die '网关模式需要在 VNT 配置指定固定虚拟 IP'
    overlap "$virtual_range" "$overlay_range" || die '虚拟 IP 不在指定虚拟网段内'
    [ "$(cat /proc/sys/net/ipv4/ip_forward)" = 1 ] || die '请启用 OpenWrt IPv4 转发'
    new_section vntcg_lan_tun rule
    set_rule src "$lan_zone"; set_rule dest vntc_openwrt
    set_rule src_ip "$lan_cidr"; add_destinations
    set_rule proto all; set_rule target ACCEPT
    new_section vntcg_tun_lan rule
    set_rule src vntc_openwrt; set_rule dest "$lan_zone"
    set_rule src_ip "$overlay_cidr"; set_rule dest_ip "$lan_cidr"
    set_rule proto all; set_rule target ACCEPT
    # 源地址转换使普通 LAN 设备无需额外的静态回程路由。
    number=0
    for network in $overlay_cidr $remote_cidr; do
        new_section "vntcg_snat_tun_$number" nat
        set_rule src vntc_openwrt; set_rule src_ip "$lan_cidr"; set_rule dest_ip "$network"
        set_rule proto all; set_rule target MASQUERADE
        number=$((number + 1))
    done
    new_section vntcg_snat_lan nat
    set_rule src "$lan_zone"; set_rule src_ip "$overlay_cidr"; set_rule dest_ip "$lan_cidr"
    set_rule proto all; set_rule target MASQUERADE
    : > "$work/ports"
    config_foreach add_service service
fi
cu commit firewall
if cmp -s "$work/firewall" /etc/config/firewall; then
    [ -s "$work/managed" ] && cp "$work/managed" "$marker" || rm -f "$marker"
    exit 0
fi
# 验证失败恢复原配置；不清空其他分区，也不改变默认路由。
cp "$work/firewall" /etc/config/firewall
if ! fw4 check >/dev/null 2>"$work/error" || grep -Eq 'Section vntcg_.*(skipped|invalid|must|not found)' "$work/error"; then
    cp "$work/original" /etc/config/firewall
    cat "$work/error" >&2
    die '规则校验失败，已恢复原防火墙配置'
fi
if ! /etc/init.d/firewall reload; then
    cp "$work/original" /etc/config/firewall
    /etc/init.d/firewall reload || true
    die '防火墙重载失败，已恢复原配置'
fi
[ -s "$work/managed" ] && cp "$work/managed" "$marker" || rm -f "$marker"
