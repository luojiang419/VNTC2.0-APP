#!/bin/sh /etc/rc.common
START=90
STOP=15
USE_PROCD=1

start_service() {
    [ -s /etc/vnts2/config.toml ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/vnts2-openwrt --conf /etc/vnts2/config.toml
    procd_set_param env TOKIO_WORKER_THREADS=1
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/vnts2/config.toml
    procd_set_param term_timeout 15
    procd_close_instance
}

reload_service() {
    stop
    start
}
